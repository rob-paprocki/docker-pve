{
  "theme": "base",
  "look": "classic",
  "htmlLabels": false,
  "markdownAutoWrap": false,
  "flowchart": {
    "htmlLabels": false,
    "padding": 8,
    "nodeSpacing": 20,
    "rankSpacing": 40,
    "wrappingWidth": 600
  },
  "themeVariables": {
    "darkMode": true,
    "fontFamily": "Arial, Helvetica, \"Liberation Sans\", sans-serif",
    "fontSize": "16px",
    "background": "#0d1117",
    "primaryColor": "#0f2a4a",
