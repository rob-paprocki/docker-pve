    "primaryBorderColor": "#4493f8",
    "secondaryColor": "#3b2e0a",
    "tertiaryColor": "#161b22",
    "lineColor": "#6e7781",
    "textColor": "#e6edf3",
    "clusterBkg": "#161b22",
    "clusterBorder": "#6e7681",
    "titleColor": "#e6edf3",
    "edgeLabelBackground": "#0d1117",
    "nodeTextColor": "#e6edf3"
